# Copy this file to .env for local overrides. All values have safe defaults.
APP_NAME=DocuDialog
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
# List syntax is JSON, for example: ["http://localhost:3000"]
CORS_ORIGINS=[]
# Database wiring is added in the next setup step.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docudialog
UPLOAD_DIRECTORY=storage/uploads
