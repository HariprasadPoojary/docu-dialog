# Copy this file to .env for local overrides. All values have safe defaults.
APP_NAME=DocuDialog
ENVIRONMENT=local
LOCAL_USER_EMAIL=developer@local.test
DEBUG=true
API_V1_PREFIX=/api/v1
# List syntax is JSON, for example: ["http://localhost:3000"]
CORS_ORIGINS=[]
POSTGRES_DB=docudialog
POSTGRES_USER=docudialog
POSTGRES_PASSWORD=docudialog-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://docudialog:docudialog-local@localhost:5432/docudialog
UPLOAD_DIRECTORY=storage/uploads
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=52428800
MAX_UPLOAD_FILES=10
# Required to run the ingestion worker. Keep API keys in local .env or a secret manager.
OPENAI_API_KEY=YOUR_API_KEY_HERE
EMBEDDING_MODEL=text-embedding-3-small
MAX_INGESTION_ATTEMPTS=3
INGESTION_POLL_SECONDS=2
INGESTION_STALE_AFTER_SECONDS=1800
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
